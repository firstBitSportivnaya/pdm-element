импорт Основное

@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
метод ЕстьПраво(ОбъектПроверки: Объект, ПравоПроверки: ПравоНаЭлемент): Булево
    возврат КонтрольДоступа.ЕстьПраво(ОбъектПроверки, ПравоПроверки)
;

@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
метод ЭтоАдминистратор(): Булево
    возврат ВспомогательныеМетоды.ЗначениеРеквизитаОбъекта(
        ВспомогательныеМетоды.ТекущийПользователь(), "Администратор") ?? Ложь
;

@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
метод ЭтоАвторизованныйПользователь(): Булево
    возврат ВспомогательныеМетоды.ТекущийПользователь() != Неопределено
;