@НаСервере @ДоступноСКлиента()
@ВПроекте
метод ЗначениеРеквизитаОбъекта(Ссылка: неизвестно, ИмяРеквизита: Строка, ИмяОбъекта = "", РеквизитПоиска =
            "Ссылка"): неизвестно
    если Ссылка == Неопределено
        возврат Неопределено
    ;

    ИмяОбъекта = ИмяОбъекта.Пусто() ? Ссылка.ПолучитьТип().Представление().Разделить(".")[0] : ИмяОбъекта

    знч Запрос = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ
            %{ИмяРеквизита} КАК %{ИмяРеквизита}
        ИЗ
            %{ИмяОбъекта} КАК %{ИмяОбъекта}
        ГДЕ
            %{ИмяОбъекта}.%{РеквизитПоиска} == &%{РеквизитПоиска}")
    Запрос.УстановитьПараметр(РеквизитПоиска, Ссылка)

    знч РезультатЗапроса = Запрос.Выполнить().ПервыйИлиНеопределено()

    возврат РезультатЗапроса == Неопределено ? РезультатЗапроса : РезультатЗапроса[ИмяРеквизита]
;

@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
метод ТекущийПользователь(): Пользователи.Ссылка|Неопределено
    возврат Пользователи.ТекущийПользователь
;