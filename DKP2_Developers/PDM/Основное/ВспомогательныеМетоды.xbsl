@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
метод ТекущийПользователь(): Пользователи.Ссылка|Неопределено
    возврат Пользователи.ТекущийПользователь
;

@НаСервере @ДоступноСКлиента()
@ВПроекте
метод ЗначениеРеквизитаОбъекта(Ссылка: неизвестно, ИмяРеквизита: Строка, ИмяОбъекта: Строка = "",
        РеквизитПоиска: Строка = "Ссылка"): неизвестно

    возврат ЗначенияРеквизитовОбъекта(Ссылка = Ссылка, ИменаРеквизитов = ИмяРеквизита, ИмяОбъекта = ИмяОбъекта,
        РеквизитПоиска = РеквизитПоиска)[ИмяРеквизита]
;

@НаСервере @ДоступноСКлиента()
@ВПроекте
метод ЗначенияРеквизитовОбъекта(Ссылка: неизвестно, ИменаРеквизитов: Строка, ИмяОбъекта: Строка = "",
        РеквизитПоиска: Строка = "Ссылка"): ЧитаемоеСоответствие<Строка, Объект?>?

    знч ЗначенияРеквизитов: Соответствие<Строка, Объект?> = {:}

    знч МассивИменРеквизитов = ИменаРеквизитов.Разделить(",")

    если Ссылка != Неопределено
        ИмяОбъекта = ИмяОбъекта.Пусто() ? Ссылка.ПолучитьТип().Представление().Разделить(".")[0] : ИмяОбъекта

        знч Запрос = новый ПроизвольныйЗапрос(
            "ВЫБРАТЬ РАЗРЕШЕННЫЕ
            %{ИменаРеквизитов}
        ИЗ
            %{ИмяОбъекта} КАК %{ИмяОбъекта}
        ГДЕ
            %{ИмяОбъекта}.%{РеквизитПоиска} == &%{РеквизитПоиска}")
        Запрос.УстановитьПараметр(РеквизитПоиска, Ссылка)

        знч РезультатЗапроса = Запрос.Выполнить()

        для Элемент из РезультатЗапроса
            для ИмяРеквизита из МассивИменРеквизитов
                если Элемент[ИмяРеквизита] != Неопределено
                    ЗначенияРеквизитов.Вставить(ИмяРеквизита, Элемент[ИмяРеквизита])
                ;
            ;
        ;
    ;

    для ИмяРеквизита из МассивИменРеквизитов
        если не ЗначенияРеквизитов.СодержитКлюч(ИмяРеквизита)
            ЗначенияРеквизитов.Вставить(ИмяРеквизита, Неопределено)
        ;
    ;

    возврат ЗначенияРеквизитов
;