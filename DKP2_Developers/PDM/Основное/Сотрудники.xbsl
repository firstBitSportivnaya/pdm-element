@Обработчик
метод ВычислитьРазрешенияДоступа(): ЧитаемаяКоллекция<РазрешениеДоступа>
    знч Ключи = [новый КлючДоступаДляАутентифицированных.Объект()]
    знч Права = [Сущность.Право.Чтение, Сущность.Право.Изменение]

    знч РазрешенияАутентифицированных = новый РазрешениеДоступа(
        Ключи,
        Права)

    возврат [РазрешенияАутентифицированных]
;

@Обработчик
метод ВычислитьРазрешенияДоступаДляОбъектов(
        Объекты: ЧитаемыйМассив<Сотрудники.ДанныеРасчетаРазрешений>): ЧитаемоеСоответствие<Сотрудники.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>

    знч РазрешенияПоОбъектам = <Сотрудники.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>{:}

    для ДанныеРасчета из Объекты
        если ДанныеРасчета.Пользователь == Неопределено
            продолжить
        ;

        знч КлючПользователя = новый КлючДоступаПользователя.Объект(ДанныеРасчета.Пользователь)
        знч РазрешенияНаОбъект = новый РазрешениеДоступа(
            [КлючПользователя],
            [Сущность.Право.Чтение, Сущность.Право.Изменение])

        РазрешенияПоОбъектам.Вставить(ДанныеРасчета, [РазрешенияНаОбъект])
    ;

    возврат РазрешенияПоОбъектам
;

@Подписка(Событие{Пользователи.Объект.ПослеПодключения})
@Локально
метод ПослеПодключенияПользователя(Источник: Пользователи.Объект)
    если СотрудникПоПользователю(Источник.Ссылка) != Неопределено
        возврат
    ;

    новый Сотрудники.Объект(
        Наименование = ПользователиСервиса.Найти(Источник.Ид).Логин,
        Пользователь = Источник.Ссылка).Записать()
;

@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
метод ТекущийСотрудник(): Сотрудники.Ссылка|Неопределено
    возврат СотрудникПоПользователю(ВспомогательныеМетоды.ТекущийПользователь())
;

@НаСервере @ДоступноСКлиента()
@ВПроекте
метод СотрудникПоПользователю(Пользователь: Пользователи.Ссылка|Неопределено): Сотрудники.Ссылка|Неопределено
    возврат ВспомогательныеМетоды.ЗначениеРеквизитаОбъекта(
        Пользователь, "Ссылка", "Сотрудники", "Пользователь")
;

@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
метод НаименованиеСотрудника(Сотрудник: Сотрудники.Ссылка|Неопределено): Строка
    возврат ВспомогательныеМетоды.ЗначениеРеквизитаОбъекта(
        Сотрудник, "Наименование") ?? ""
;