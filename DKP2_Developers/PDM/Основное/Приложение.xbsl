импорт СистемаПравДоступа

метод Заголовок(): Строка?
    пер ПредставлениеСотрудника = ""

    если СистемаПравДоступа.ЭтоАвторизованныйПользователь()
        знч НаименованиеСотрудника = Сотрудники.НаименованиеСотрудника(Сотрудники.ТекущийСотрудник())
        ПредставлениеСотрудника = НаименованиеСотрудника.Пусто() ? "Неопределенный" : НаименованиеСотрудника
    иначе
        ПредставлениеСотрудника = "Гость"
    ;

    возврат Проект.Представление + " (%{ПредставлениеСотрудника})"
;

метод ВойтиВыйтиПредставление(): Строка
    //Не отрабатывает серверный вызов
    //возврат СистемаПравДоступа.ЭтоАвторизованныйПользователь() ? "Выйти" : "Войти"
    возврат "Войти/Выйти"
;

метод ВойтиВыйтиОбработчик(Команда: ОбычнаяКоманда)
    если СистемаПравДоступа.ЭтоАвторизованныйПользователь()
        Аутентификация.ЗавершитьТекущийСеанс(НавигационнаяСсылка.Абсолютная(Тип<Приложение>))
    иначе
        ПерейтиПоСсылке(НавигационнаяСсылка.Абсолютная(Тип<ПриложениеАутентификация>), Ложь)
    ;
;

метод ВойтиВыйтиИзображение(): ДвоичныйОбъект.Ссылка
    возврат СистемаПравДоступа.ЭтоАвторизованныйПользователь() ? Ресурс{Стд::Вход.svg}.Ссылка
        : Ресурс{Стд::Выход.svg}.Ссылка
;