@НаСервере @ДоступноСКлиента(КешироватьРезультат = Истина)
@ВПроекте
статический метод ЭтоАвторизованныйПользователь(): Булево
    возврат Пользователи.ТекущийПользователь != Неопределено
;

метод ВойтиВыйтиПредставление(): Строка
    //Не отрабатывает серверный вызов
    //возврат ЭтоАвторизованныйПользователь() ? "Выйти" : "Войти"

    возврат "Войти/Выйти"
;

метод ВойтиВыйтиОбработчик(Команда: ОбычнаяКоманда)
    если ЭтоАвторизованныйПользователь()
        Аутентификация.ЗавершитьТекущийСеанс(НавигационнаяСсылка.Абсолютная(Тип<Приложение>))
    иначе
        ПерейтиПоСсылке(НавигационнаяСсылка.Абсолютная(Тип<ПриложениеАутентификация>), Ложь)
    ;
;

метод ВойтиВыйтиИзображение(): ДвоичныйОбъект.Ссылка
    возврат ЭтоАвторизованныйПользователь() ? Ресурс{Стд::Вход.svg}.Ссылка : Ресурс{Стд::Выход.svg}.Ссылка
;