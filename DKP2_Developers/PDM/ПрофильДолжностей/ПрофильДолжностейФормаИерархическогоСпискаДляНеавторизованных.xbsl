@ВПроекте
@НаСервере
@НаКлиенте
структура СтруктураДолжности
    обз знч Наименование: Строка
    знч Описание: Строка
    знч Поддолжности: Массив<СтруктураДолжности>
;

метод ПолучитьНаименованиеДолжности(ДанныеСтроки: УзелДереваСДанными<СтруктураДолжности?>): Строка
    возврат ДанныеСтроки.Данные.Наименование
;

метод ПолучитьОписаниеДолжности(ДанныеСтроки: УзелДереваСДанными<СтруктураДолжности?>): Строка
    возврат ДанныеСтроки.Данные.Описание
;

@Обработчик
метод ПослеСоздания()
    пер МассивДолжностей = ПрочитатьДолжности()
    Компоненты.ИерархическийСписокДолжностей.Источник.Данные.ДобавитьВсе(МассивДолжностей)

    Компоненты.ИерархическийСписокДолжностей.Свернуть(Неопределено, -1)
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьДолжности(): Массив<УзелДереваСДанными<СтруктураДолжности?>>
    пер Запрос = Запрос{
        ВЫБРАТЬ
            ПрофильДолжностей.Ссылка КАК Ссылка,
            ПрофильДолжностей.Родитель КАК Родитель,
            ПрофильДолжностей.Наименование КАК Наименование,
            ПрофильДолжностей.Описание КАК Описание
        ИЗ
            ПрофильДолжностей КАК ПрофильДолжностей
    }

    пер Результат = <УзелДереваСДанными<СтруктураДолжности?>>[]

    пер ДолжностиПоРодителю = <ПрофильДолжностей.Ссылка, УзелДереваСДанными<СтруктураДолжности?>>{:}
    пер Должности = Запрос.Выполнить().ВМассив()
    для Должность из Должности
        пер ДолжностьПоРодителю = новый УзелДереваСДанными<СтруктураДолжности?>()
        ДолжностьПоРодителю.Данные = новый СтруктураДолжности(
            Наименование = Должность.Наименование,
            Описание = Должность.Описание)
        ДолжностиПоРодителю.Вставить(Должность.Ссылка, ДолжностьПоРодителю)
    ;

    для Должность из Должности
        пер Элемент = ДолжностиПоРодителю.Получить(Должность.Ссылка)
        если Должность.Родитель != Неопределено
            ДолжностиПоРодителю.Получить(Должность.Родитель).ДочерниеЭлементы.Добавить(Элемент)
        иначе
            Результат.Добавить(Элемент)
        ;
    ;

    возврат Результат
;