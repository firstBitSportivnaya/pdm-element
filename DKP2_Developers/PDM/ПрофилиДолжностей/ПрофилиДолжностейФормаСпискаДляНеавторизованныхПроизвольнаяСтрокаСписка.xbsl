импорт Основное

@ВПодсистеме
@НаСервере
@НаКлиенте
структура СтруктураСтроки
    обз знч Наименование: Строка
    знч ПодчиненныеСтроки: Массив<СтруктураСтроки>
;

@Обработчик
метод ПослеСоздания()
    знч ПрофильДолжности = ДанныеСтроки.Ключ как ПрофилиДолжностей.Ссылка

    ЗаполнитьДанныеИзПрофиляДолжности(ПрофильДолжности)

    Компоненты.ТребуемыеТехническиеНавыки.Источник.Данные.ДобавитьВсе(ПрочитатьДанныеДляСтрок(ПрофильДолжности,
            "ТехническиеНавыки", "ТехническийНавык"))
    Компоненты.ТребуемыеЛичныеНавыки.Источник.Данные.ДобавитьВсе(ПрочитатьДанныеДляСтрок(ПрофильДолжности,
            "ЛичныеНавыки", "ЛичныйНавык"))
    Компоненты.ТребуемыеФункциональныеОбязанности.Источник.Данные.ДобавитьВсе(ПрочитатьДанныеДляСтрок(ПрофильДолжности,
            "ФункциональныеОбязанности", "ФункциональнаяОбязанность"))
;

@ВПодсистеме
метод ПолучитьНаименованиеПрофиляДолжности(): Строка
    возврат (ДанныеСтроки.Данные как ПрофилиДолжностей.АвтоматическаяФормаСписка.ДанныеСтрокиСписка).Наименование
;

@ВПодсистеме
метод ЗаполнитьДанныеИзПрофиляДолжности(ПрофильДолжности: ПрофилиДолжностей.Ссылка?)
    знч ЗначенияРеквизитовПрофиляДолжности =
        ВспомогательныеМетоды.ЗначенияРеквизитовОбъекта(ПрофильДолжности, "Уровень,Опыт,СледующаяДолжность")

    знч ПрофильСледующейДолжности = ЗначенияРеквизитовПрофиляДолжности["СледующаяДолжность"]
    знч ЗначенияРеквизитовПрофиляСледующейДолжности = ВспомогательныеМетоды.ЗначенияРеквизитовОбъекта(
            ПрофильСледующейДолжности, "Ссылка,Уровень,Опыт")

    Компоненты.Опыт.Значение = ЗначенияРеквизитовПрофиляДолжности["Опыт"]
    Компоненты.Уровень.Значение = ЗначенияРеквизитовПрофиляДолжности["Уровень"]

    Компоненты.СледующаяДолжность.Значение = ЗначенияРеквизитовПрофиляСледующейДолжности["Ссылка"]
    Компоненты.ОпытСледующейДолжности.Значение = ЗначенияРеквизитовПрофиляСледующейДолжности["Опыт"]
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьДанныеДляСтрок(ПрофильДолжности: ПрофилиДолжностей.Ссылка?, ИмяТабличнойЧасти: Строка,
        ИмяРеквизитаТабличнойЧасти: Строка): Массив<УзелДереваСДанными<СтруктураСтроки?>>?

    если ПрофильДолжности == Неопределено
        возврат Неопределено
    ;

    знч ИмяОбъекта = "ПрофилиДолжностей"

    пер Запрос = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
            %{ИмяТабличнойЧасти}.Ссылка КАК Ссылка
        ПОМЕСТИТЬ ВТ_%{ИмяТабличнойЧасти}
        ИЗ
            %{ИмяОбъекта}.%{ИмяТабличнойЧасти} КАК %{ИмяОбъекта}%{ИмяТабличнойЧасти}
            ЛЕВОЕ СОЕДИНЕНИЕ %{ИмяТабличнойЧасти} КАК %{ИмяТабличнойЧасти}
                ПО %{ИмяОбъекта}%{ИмяТабличнойЧасти}.%{ИмяРеквизитаТабличнойЧасти} == %{ИмяТабличнойЧасти}.Ссылка
        ГДЕ
            %{ИмяОбъекта}%{ИмяТабличнойЧасти}.Владелец == &Владелец
        ;
        ВЫБРАТЬ РАЗРЕШЕННЫЕ
            ВТ_%{ИмяТабличнойЧасти}.Ссылка КАК Ссылка
        ИЗ
            ВТ_%{ИмяТабличнойЧасти} КАК ВТ_%{ИмяТабличнойЧасти}

        ОБЪЕДИНИТЬ ВСЕ

        ВЫБРАТЬ РАЗРЕШЕННЫЕ
            %{ИмяТабличнойЧасти}.Ссылка
        ИЗ
            %{ИмяТабличнойЧасти} КАК %{ИмяТабличнойЧасти}
        ГДЕ
            %{ИмяТабличнойЧасти}.Родитель В (ВЫБРАТЬ
                    ВТ_%{ИмяТабличнойЧасти}.Ссылка КАК Ссылка
                ИЗ
                    ВТ_%{ИмяТабличнойЧасти} КАК ВТ_%{ИмяТабличнойЧасти})")
    Запрос.УстановитьПараметр("Владелец", ПрофильДолжности)

    знч РезультатЗапроса = Запрос.Выполнить()

    знч ЗначенияТабличнойЧасти: Массив<ТехническиеНавыки.Ссылка|ЛичныеНавыки.Ссылка|ФункциональныеОбязанности.Ссылка>

    для СтрокаРезультата из РезультатЗапроса
        если СтрокаРезультата.Ссылка != Null
            ЗначенияТабличнойЧасти.Добавить(СтрокаРезультата.Ссылка)
        ;
    ;

    Запрос = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
            %{ИмяТабличнойЧасти}.Ссылка КАК Ссылка,
            %{ИмяТабличнойЧасти}.Родитель КАК Родитель,
            %{ИмяТабличнойЧасти}.Наименование КАК Наименование
        ИЗ
            %{ИмяТабличнойЧасти} КАК %{ИмяТабличнойЧасти}
        ГДЕ
            %{ИмяТабличнойЧасти}.Ссылка.Ссылка В (&Ссылки)")
    Запрос.УстановитьПараметр("Ссылки", ЗначенияТабличнойЧасти)

    пер Результат = <УзелДереваСДанными<СтруктураСтроки?>>[]

    пер ДолжностиПоРодителю =
        <ТехническиеНавыки.Ссылка|ЛичныеНавыки.Ссылка|ФункциональныеОбязанности.Ссылка, УзелДереваСДанными<СтруктураСтроки?>>{:}
    пер Должности = Запрос.Выполнить().ВМассив()
    для Должность из Должности
        пер ДолжностьПоРодителю = новый УзелДереваСДанными<СтруктураСтроки?>()
        ДолжностьПоРодителю.Данные = новый СтруктураСтроки(
            Наименование = Должность.Наименование)
        ДолжностиПоРодителю.Вставить(Должность.Ссылка, ДолжностьПоРодителю)
    ;

    для Должность из Должности
        пер Элемент = ДолжностиПоРодителю.Получить(Должность.Ссылка)
        если Должность.Родитель != Неопределено
            ДолжностиПоРодителю.Получить(Должность.Родитель).ДочерниеЭлементы.Добавить(Элемент)
        иначе
            Результат.Добавить(Элемент)
        ;
    ;

    возврат Результат
;